# Public Firebase App Check reCAPTCHA v3 site key. This is not a server secret.
# Configure the matching site in Firebase App Check before deploying callable use.
REACT_APP_FIREBASE_APPCHECK_SITE_KEY=

# Reviewed public origin, without path or trailing slash. Never guess a domain.
REACT_APP_CANONICAL_ORIGIN=

# Local synthetic development only; must be false/absent in release builds.
REACT_APP_USE_EMULATORS=false
