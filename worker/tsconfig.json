{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": ["@cloudflare/workers-types", "node"],
    "strict": true, "allowJs": true, "checkJs": false,
    "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"]
}
